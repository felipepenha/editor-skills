# Overleaf Community Edition Environment Configuration
# Copy to overleaf.env and modify as needed

# --- Application Settings ---
OVERLEAF_APP_NAME="Overleaf Community Edition"
OVERLEAF_NAV_TITLE="Overleaf Community Edition"
OVERLEAF_SITE_URL=http://localhost:8080
OVERLEAF_PORT=8080

# --- User & Registration Policy ---
# Set to 'true' to allow users to register without verifying email
EMAIL_CONFIRMATION_DISABLED=true
# Required persistent random secret for signing invitation tokens (e.g. openssl rand -hex 32)
OVERLEAF_INVITE_TOKEN_SECRET=your_32_byte_random_secret_here

# --- Database & Cache Connection ---
# If using Podman Pod mode: both MongoDB and Redis reside on 127.0.0.1
# If using Podman Network mode: set to container names (e.g. mongodb://overleaf-mongo:27017/sharelatex)
OVERLEAF_MONGO_URL=mongodb://127.0.0.1:27017/sharelatex
OVERLEAF_REDIS_HOST=127.0.0.1
OVERLEAF_REDIS_PORT=6379


# --- Features & Conversions ---
ENABLE_CONVERSIONS=true
ENABLED_LINKED_FILE_TYPES=project_file,project_output_file
OVERLEAF_PROXY_LEARN=true

# --- Email / SMTP Settings (Optional) ---
# OVERLEAF_EMAIL_FROM_ADDRESS=support@example.com
# OVERLEAF_EMAIL_SMTP_HOST=smtp.example.com
# OVERLEAF_EMAIL_SMTP_PORT=587
# OVERLEAF_EMAIL_SMTP_SECURE=false
# OVERLEAF_EMAIL_SMTP_USER=user
# OVERLEAF_EMAIL_SMTP_PASS=password
# OVERLEAF_EMAIL_SMTP_TLS_REJECT_UNAUTH=true
# OVERLEAF_EMAIL_SMTP_IGNORE_TLS=false
